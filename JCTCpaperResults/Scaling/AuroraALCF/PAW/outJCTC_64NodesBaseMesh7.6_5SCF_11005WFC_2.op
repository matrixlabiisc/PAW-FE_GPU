    set D4 MBD                     = false
    set DAMPING PARAMETERS FILE    =
    set DISPERSION CORRECTION TYPE = 0
    set THREE BODY CUTOFF          = 40.0
    set TWO BODY CUTOFF            = 94.8683298050514
