  set USE ATOMIC MAGNETIZATION GUESS FOR CONSTRAINT MAG = false
  set USE LIBXC FOR XC FUNCTIONAL EVALUATION            = false
  subsection CONFINING POTENTIAL parameters
    set APPLY CONFINING POTENTIAL = false
    set C PARAM                   = 1.0
