set SOLVER MODE = GS
set VERBOSITY = 4
set USE GPU = true
set MEM OPT MODE                                    = false
subsection Geometry
  set NATOMS=309
  set NATOM TYPES=1
  set ATOMIC COORDINATES FILE      = coordinates.inp           
  set DOMAIN VECTORS FILE = domainBoundingVectors.inp 
  subsection Optimization
    set CELL STRESS = false
    set ION FORCE = true
  end
end


subsection Boundary conditions
  set PERIODIC1                       = false
  set PERIODIC2                       = false
  set PERIODIC3                       = false
end

subsection Finite element mesh parameters
  set DENSITY QUADRATURE RULE          = 10
  set LOCAL POTENTIAL QUADRATURE COPY  = 1
  set LOCAL POTENTIAL QUADRATURE ORDER = 10
  set NON LOCAL PSP QUADRATURE COPY    = 2
  set NON LOCAL PSP QUADRATURE ORDER   = 12
  set NUCLEAR CHARGE QUADRATURE COPY   = 2
  set NUCLEAR CHARGE QUADRATURE ORDER  = 12
  set POLYNOMIAL ORDER                 = 6
  set POLYNOMIAL ORDER DENSITY NODAL   = 0
  set POLYNOMIAL ORDER ELECTROSTATICS  = 0
  subsection Auto mesh generation parameters
    set MESH SIZE AROUND ATOM  = 2.0
    set ATOM BALL RADIUS                  = 4.5
  end
end

subsection DFT functional parameters
  set EXCHANGE CORRELATION TYPE   = GGA-PBE
  set PSEUDOPOTENTIAL CALCULATION = true  
  set PSEUDOPOTENTIAL FILE NAMES LIST = pseudo_JTH2.inp
  set USE LIBXC FOR XC FUNCTIONAL EVALUATION            = false  
end

subsection SCF parameters
  set TEMPERATURE                      = 500
  set TOLERANCE                        = 1.5e-4
    set USE APPROX DELTA MATRIX                 = true
    set ADAPT ANDERSON MIXING PARAMETER         = true
    set MIXING PARAMETER                        = 0.02
    set USE GRAD PHI MIXING                     = true
  subsection Eigen-solver parameters
      set CHEBYSHEV POLYNOMIAL DEGREE                          = 15
    set CHEBYSHEV POLYNOMIAL DEGREE SCALING FACTOR FIRST SCF = 2.1
      set NUMBER OF KOHN-SHAM WAVEFUNCTIONS = 1800
      set CHEBY WFC BLOCK SIZE                                 = 450
      set WFC BLOCK SIZE                                       = 450
    set OVERLAP COMPUTE COMMUN CHEBY                         = false
    set OVERLAP COMPUTE COMMUN ORTHO RR                      = true          
      set USE APPROXIMATE OVERLAP MATRIX                       = false  
      set USE SINGLE PREC CHEBY                                = false 
    set REUSE LANCZOS UPPER BOUND                            = true   
    set USE MIXED PREC RR_SR                                 = false     
  end    
end


subsection GPU
  set AUTO GPU BLOCK SIZES         = false
  set FINE GRAINED GPU TIMINGS     = true
  set SUBSPACE ROT FULL CPU MEM    = true
  set USE DCCL                     = false
  set USE ELPA GPU KERNEL          = true
  set USE GPUDIRECT MPI ALL REDUCE = false
end

subsection Poisson problem parameters
  set GPU MODE           = true
  set MAXIMUM ITERATIONS = 20000
  set TOLERANCE          = 1e-10
  set VSELF GPU MODE     = true
end