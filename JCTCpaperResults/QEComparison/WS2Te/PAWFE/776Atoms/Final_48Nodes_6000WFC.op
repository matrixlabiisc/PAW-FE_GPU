  set POLYNOMIAL ORDER ELECTROSTATICS      = 7
  set USE HIGH QUADRATURE RULE             = false
  set USE INTERMEDIATE DENSITY QUADRATURE  = false
  subsection Auto mesh generation parameters
    set ATOM BALL RADIUS                  = 4.0
    set AUTO ADAPT BASE MESH SIZE         = false
    set BASE MESH SIZE                    = 3.1
    set GAUSSIAN CONSTANT FORCE GENERATOR = 0.75
    set GAUSSIAN ORDER FORCE GENERATOR    = 4.0
    set GAUSSIAN ORDER MOVE MESH TO ATOMS = 4.0
    set INNER ATOM BALL RADIUS            = 0.0
