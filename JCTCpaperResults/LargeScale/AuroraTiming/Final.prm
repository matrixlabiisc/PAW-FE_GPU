set SOLVER MODE = GS
set VERBOSITY = 4
set MEM OPT MODE = false
set USE GPU = true
subsection Geometry
  set NATOMS=11544
  set NATOM TYPES=2
  set ATOMIC COORDINATES FILE      = coordinates.inp 
  set DOMAIN VECTORS FILE = domainVectors.inp
  subsection Optimization
    set ION FORCE = false
  end
end

subsection Boundary conditions
  set PERIODIC1                       = true
  set PERIODIC2                       = true
  set PERIODIC3                       = false
 set APPLY NEUMANN BOUNDARY CONDITION = true  
end
subsection Finite element mesh parameters
  set POLYNOMIAL ORDER=5
    set POLYNOMIAL ORDER ELECTROSTATICS = 7
  set DENSITY QUADRATURE RULE          = 16
  set LOCAL POTENTIAL QUADRATURE COPY  = 1
  set LOCAL POTENTIAL QUADRATURE ORDER = 16
  set NON LOCAL PSP QUADRATURE COPY    = 2
  set NON LOCAL PSP QUADRATURE ORDER   = 9
  set NUCLEAR CHARGE QUADRATURE COPY   = 3
  set NUCLEAR CHARGE QUADRATURE ORDER  = 8 
  subsection Auto mesh generation parameters
    set MESH SIZE AROUND ATOM  = 1.6
    set ATOM BALL RADIUS = 4.0
    set AUTO ADAPT BASE MESH SIZE         = false
    set BASE MESH SIZE                    = 6.1    
  end
end

subsection DFT functional parameters
  set EXCHANGE CORRELATION TYPE   = GGA-PBE
  set PSEUDOPOTENTIAL CALCULATION = true  
  set PSEUDOPOTENTIAL FILE NAMES LIST = pseudo.inp
  set PAW GPU XC EVALUATION                             = true  
end

subsection SCF parameters
  set ADAPT ANDERSON MIXING PARAMETER = true
  set MIXING METHOD                   = ANDERSON
  set MIXING PARAMETER                 = 0.1
  set MIXING HISTORY           = 15
  set TEMPERATURE                      = 4
  set TOLERANCE                        = 1e-7
    set USE APPROX DELTA MATRIX                 = true
  set USE GRAD PHI MIXING                     = false
  set ADAPT ANDERSON MIXING PARAMETER         = true
  set MAXIMUM ITERATIONS                      = 5
  subsection Eigen-solver parameters
    set CHEBYSHEV POLYNOMIAL DEGREE                          = 18
    set CHEBYSHEV POLYNOMIAL DEGREE SCALING FACTOR FIRST SCF = 1.8  
      set NUMBER OF KOHN-SHAM WAVEFUNCTIONS = 72000
      set CHEBY WFC BLOCK SIZE                                 = 800
      set WFC BLOCK SIZE                                       = 800
      set OVERLAP COMPUTE COMMUN CHEBY                         = true    
          set USE APPROXIMATE OVERLAP MATRIX                       = false  
      set USE SINGLE PREC CHEBY                                = true  
      set OVERLAP COMPUTE COMMUN ORTHO RR = true
    set USE MIXED PREC XTHX                                  = true
    set USE MIXED PREC XTOX                                  = true      
      set USE MIXED PREC RR_SR                                 = true 
      set COMMUN PREC CHEBY                                    = BF16
      set SUBSPACE ROT DOFS BLOCK SIZE                         = 100000
    set NUMBER OF CORE EIGEN STATES FOR MIXED PREC RR        = 35000  
      
set TENSOR OP TYPE SINGLE PREC CHEBY                     = TF32  
      set REUSE LANCZOS UPPER BOUND                            = true
      set RESTRICT TO SINGLE FILTER PASS                       = true         
  end
end



subsection Poisson problem parameters
  set GPU MODE              = true
  set LOW DEGREE POLYNOMIAL = 4
  set MAXIMUM ITERATIONS    = 20000
  set TOLERANCE             = 1e-8
  set TOLERANCE COARSE      = 1e-8
  set USE TWO GRID POISSON  = true
  set VSELF GPU MODE        = true
end
subsection GPU
  set AUTO GPU BLOCK SIZES         = false
  set FINE GRAINED GPU TIMINGS     = true
  set SUBSPACE ROT FULL CPU MEM    = true
  set USE DCCL                     = true
  set USE ELPA GPU KERNEL          = false
  set USE GPUDIRECT MPI ALL REDUCE = true
end
